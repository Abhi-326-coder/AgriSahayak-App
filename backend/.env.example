# =============================================
# AgriSahayak Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# Application
APP_NAME=AgriSahayak
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# Database (optional for Phase 1 - app runs without it using mock data)
DATABASE_URL=
# Example: postgresql://agrisahayak_user:password@localhost:5432/agrisahayak

# CORS Origins (comma-separated)
# For local development with Expo:
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# AI / LLM (Phase 4+)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Voice AI (Phase 7)
VOICE_API_KEY=
SARVAM_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Weather API (Phase 3)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# Market Data
AGMARKNET_API_KEY=
