# =============================================
# AgriSahayak Root Environment Reference
# =============================================
# Copy relevant sections to mobile/.env and backend/.env

# ---- MOBILE (mobile/.env) ----
# EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000/api/v1
# For Android Emulator: http://10.0.2.2:8000/api/v1
# For Physical Device: http://192.168.x.x:8000/api/v1
# For Production: https://api.agrisahayak.com/api/v1

# ---- BACKEND (backend/.env) ----
# APP_NAME=AgriSahayak
# ENVIRONMENT=development
# DEBUG=true
# DATABASE_URL=postgresql://agrisahayak_user:yourpassword@localhost:5432/agrisahayak
# SECRET_KEY=your-secret-key-change-in-production
# LLM_API_KEY=
# VOICE_API_KEY=
# SARVAM_API_KEY=
# BHASHINI_API_KEY=
# WEATHER_API_KEY=
