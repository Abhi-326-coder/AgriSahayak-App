# =============================================
# AgriSahayak Mobile Environment Variables
# =============================================
# Copy to .env and fill in your values.
# All EXPO_PUBLIC_ variables are embedded at build time.

# Backend API URL
# ⚠️  Physical Android devices CANNOT use 'localhost'
# Use your local network IP address instead.
#
# Android Emulator:  EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# Physical Device:   EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
# Production:        EXPO_PUBLIC_API_URL=https://api.agrisahayak.com/api/v1
#
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000/api/v1

# App Environment
EXPO_PUBLIC_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_VOICE=true
EXPO_PUBLIC_ENABLE_CAMERA=true
