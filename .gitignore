# =============================
# AgriSahayak .gitignore
# =============================

# Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# =============================
# Mobile (React Native / Expo)
# =============================
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/build/
mobile/.expo-shared/
mobile/android/
mobile/ios/
mobile/web-build/
mobile/*.orig.*
mobile/yarn-error.log

# =============================
# Backend (Python)
# =============================
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/*.egg-info/
backend/dist/
backend/build/
backend/.mypy_cache/
backend/.ruff_cache/

# =============================
# Database
# =============================
*.db
*.sqlite
*.sqlite3

# =============================
# OS Files
# =============================
.DS_Store
Thumbs.db
desktop.ini

# =============================
# IDE / Editor
# =============================
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# =============================
# Logs
# =============================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# =============================
# Docker
# =============================
docker/postgres-data/

# =============================
# AI / ML
# =============================
*.pkl
*.model
*.h5
*.pt
*.onnx
chroma_db/
vector_store/
